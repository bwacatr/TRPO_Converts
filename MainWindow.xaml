<Window x:Class="TRPO_Converts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TRPO_Converts"
        mc:Ignorable="d"
        xmlns:models="clr-namespace:TRPO_Converts.Models"
        xmlns:converters="clr-namespace:TRPO_Converts.Converters"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <models:Product x:Key="product"/>
        <converters:DiscountConverter x:Key="discountConverter"/>
        <converters:PriceStrikeThroughConverter x:Key="priceStrikethroughConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource product}"/>
    </Window.DataContext>
    
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <StackPanel>
                <Label>Id</Label>
                <TextBox Text="{Binding Id,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel >
                <Label>Название</Label>
                <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel >
                <Label>Цена</Label>
                <TextBox Text="{Binding Price}"/>
            </StackPanel>

            <StackPanel >
                <Label>Скидка(в %)</Label>
                <TextBox Text="{Binding Discount,Converter={StaticResource discountConverter},UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">

            <StackPanel>
                <Label>Id:</Label>
                <TextBlock Text="{Binding Id}"/>
            </StackPanel>

            <StackPanel>
                <Label>Название:</Label>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>

            <StackPanel>
                <Label>Цена:</Label>
                <TextBlock Text="{Binding Price, StringFormat={}{0:C},ConverterCulture=ru-RU}"
                           TextDecorations="{Binding PriceDiscount,Converter={StaticResource priceStrikethroughConverter}}"/>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Discount}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    
                </StackPanel.Style>
                <Label>Цена со скидкой:</Label>
                <TextBlock Text="{Binding PriceDiscount, StringFormat={}{0:C},ConverterCulture=ru-RU, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Discount}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <Label>Скидка(в %):</Label>
                <TextBlock Text="{Binding Discount, StringFormat={}{0:P0}}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
