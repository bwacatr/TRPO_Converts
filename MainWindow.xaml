<Window x:Class="TRPO_Converts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TRPO_Converts"
        mc:Ignorable="d"
        xmlns:models="clr-namespace:TRPO_Converts.Models"
        xmlns:converters="clr-namespace:TRPO_Converts.Converters"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <models:Parcel x:Key="parcel"/>
        <converters:WeightConverter x:Key="WeightConverter"/>
        <converters:ColorConverter x:Key="ColorConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource parcel}"/>
    </Window.DataContext>
    
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <StackPanel>
                <Label>Получатель</Label>
                <TextBox Text="{Binding Recipient,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel >
                <Label>Вес в граммах</Label>
                <TextBox Text="{Binding Weight,Converter={StaticResource WeightConverter},UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel >
                <Label>Цена за каждый кг</Label>
                <TextBox Text="{Binding RatePerKg,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel >
                <Label>Доп. сбор</Label>
                <TextBox Text="{Binding Surcharge, TargetNullValue='',UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">

            <StackPanel>
                <Label>Получитель:</Label>
                <TextBlock Text="{Binding Recipient}"/>
            </StackPanel>

            <StackPanel>
                <Label>Вес в кг:</Label>
                <TextBlock Text="{Binding Weight, StringFormat={}{0} кг}"/>
            </StackPanel>

            <StackPanel>
                <Label>Цена:</Label>
                <TextBlock Text="{Binding DeliveryCostWithoutSurcharge, StringFormat={}{0:C},ConverterCulture=ru-RU}"/>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Surcharge}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    
                </StackPanel.Style>
                <Label>Цена с доп. сбором:</Label>
                <TextBlock Text="{Binding DeliveryCost, StringFormat={}{0:C},ConverterCulture=ru-RU, Mode=OneWay}"
                           Foreground="{Binding DeliveryCost,Converter={StaticResource ColorConverter}}"/>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Surcharge}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <Label>Доп. сбор:</Label>
                <TextBlock Text="{Binding Surcharge, StringFormat={}{0:C},ConverterCulture=ru-RU}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
